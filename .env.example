# QQ 开放平台 -> 机器人 -> 开发设置
QQ_APP_ID=填入你的QQ机器人AppID
QQ_APP_SECRET=填入你的QQ机器人AppSecret

# DeepSeek 开放平台 -> API Keys
DEEPSEEK_API_KEY=填入你的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-flash

# true：由模型自动判断是否需要联网搜索；不需要额外搜索密钥
WEB_SEARCH_ENABLED=true

# 允许在 @ 消息中附图提问
VISION_ENABLED=true

# 每群共享的持久记忆；相对路径以项目目录为基准
MEMORY_DB_PATH=data/memory.sqlite3
